# BioFuse Environment Configuration
# Copy this file to .env and fill in your values

# HuggingFace Authentication Token
# Get your token from https://huggingface.co/settings/tokens
# Required for gated models like UNI, CONCH, CheXagent, etc.
HF_TOKEN=hf_your_token_here

# Optional: Custom cache directory for HuggingFace models
# If not set, defaults to ~/.cache/huggingface or /data/hf-hub (if writable)
# HF_HOME=/path/to/your/cache

# Optional: Custom cache directory for BioFuse embeddings
# If not set, defaults to /data/biofuse-embedding-cache or ~/biofuse-cache
# BIOFUSE_CACHE_DIR=/path/to/embedding/cache
